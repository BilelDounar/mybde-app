# Configuration API pour Expo / React Native
# Copiez ce fichier en .env.local et adaptez l'URL

# Pour iOS/Android physique :
# 1. Trouvez l'IP locale de votre PC :
#    - Windows : ipconfig
#    - Mac/Linux : ifconfig
# 2. Remplacez par votre IP (ex: 192.168.1.42)
# 3. Assurez-vous que téléphone et PC sont sur le même WiFi

EXPO_PUBLIC_API_URL=http://localhost:3000
# EXPO_PUBLIC_API_URL=http://192.168.1.42:3000
